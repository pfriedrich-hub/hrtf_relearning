+            base.name = base_name
+            out.append(save_waterfall_qc(base, hrtf, sofa, plot_dir=plot_dir))
+        logging.info("Saved HRTF waterfall(s): %s", ", ".join(str(p) for p in out))
+        return out[0] if len(out) == 1 else out
